rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all authenticated users for now
    // This is for development/testing purposes
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // More specific rules for different collections
    match /leaderboard/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /student_achievements/{achievementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /achievements/{achievementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    }
    
    match /users/{userId} {
      // Users can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Administrators can read all users
      allow read: if request.auth != null && isAdmin();
      // Administrators can update user roles
      allow update: if request.auth != null && isAdmin() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }
    
    match /teacher_feedback/{feedbackId} {
      allow read, write: if request.auth != null;
    }
    
    match /teacher_recommendations/{recommendationId} {
      allow read, write: if request.auth != null;
    }
    
    // Student feedback collection
    match /student_feedback/{feedbackId} {
      // Students can read their own feedback, teachers can read/write
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.studentId || 
                      request.auth.uid == resource.data.teacherId);
      allow write: if request.auth != null && 
                      (request.auth.uid == resource.data.teacherId || 
                       request.auth.uid == request.resource.data.teacherId);
    }
    
    // Student recommendations collection
    match /student_recommendations/{recommendationId} {
      // Students can read their own recommendations, teachers can read/write
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.studentId || 
                      request.auth.uid == resource.data.teacherId);
      allow write: if request.auth != null && 
                      (request.auth.uid == resource.data.teacherId || 
                       request.auth.uid == request.resource.data.teacherId);
    }
    
    // Classes collection (for section/class management)
    match /classes/{classId} {
      // Teachers can read/write their own classes, students can read classes they're enrolled in
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.teacherId || 
                      resource.data.enrolledStudentIds.hasAny([request.auth.uid]));
      allow write: if request.auth != null && 
                      (request.auth.uid == resource.data.teacherId || 
                       request.auth.uid == request.resource.data.teacherId);
    }
    
    // Class enrollments collection
    match /class_enrollments/{enrollmentId} {
      // Students can read their own enrollments, teachers can read/write
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.studentId || 
                      request.auth.uid == resource.data.teacherId);
      allow write: if request.auth != null && 
                      (request.auth.uid == resource.data.teacherId || 
                       request.auth.uid == request.resource.data.teacherId);
    }
    
    // Lesson progress collection (individual tracking)
    match /lesson_progress/{progressId} {
      // Students can read/write their own progress, teachers can read
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.studentId || 
                      request.auth.uid == resource.data.teacherId);
      allow write: if request.auth != null && 
                      request.auth.uid == resource.data.studentId;
    }
    
    // Student ratings collection
    match /student_ratings/{ratingId} {
      // Students can read their own ratings, teachers can read/write
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.studentId || 
                      request.auth.uid == resource.data.teacherId);
      allow write: if request.auth != null && 
                      (request.auth.uid == resource.data.teacherId || 
                       request.auth.uid == request.resource.data.teacherId);
    }
  }
}

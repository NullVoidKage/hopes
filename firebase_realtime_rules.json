{
  "rules": {
    "lessons": {
      ".indexOn": ["teacherId", "subject", "createdAt", "schoolYear"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$lessonId": {
        ".read": "auth != null && (data.child('teacherId').val() == auth.uid || data.child('isPublished').val() == true)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['title', 'subject', 'content', 'teacherId', 'teacherName'])"
      }
    },
    "assessments": {
      ".indexOn": ["teacherId", "subject", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$assessmentId": {
        ".read": "auth != null && (data.child('teacherId').val() == auth.uid || data.child('isPublished').val() == true)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['title', 'subject', 'teacherId', 'teacherName'])"
      }
    },
    "teacher_activities": {
      "$teacherId": {
        ".read": "auth != null && auth.uid == $teacherId",
        ".write": "auth != null && auth.uid == $teacherId"
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "student_progress": {
      ".indexOn": ["teacherId", "subject", "lastActivity"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['studentId', 'studentName', 'studentEmail', 'subject', 'teacherId'])"
      }
    },
    "students": {
      ".indexOn": ["teacherId", "grade", "joinedAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name', 'email', 'grade', 'section', 'subjects', 'teacherId', 'teacherName'])"
      }
    },
    "assessment_submissions": {
      ".indexOn": ["assessmentId", "studentId", "teacherId", "submittedAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$submissionId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && data.child('studentId').val() == auth.uid",
        ".validate": "newData.hasChildren(['assessmentId', 'studentId', 'answers', 'timeSpent', 'submittedAt'])"
      }
    },
    "leaderboard": {
      ".indexOn": ["totalPoints", "lastActivity"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "student_achievements": {
      ".indexOn": ["studentId", "unlockedAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$achievementId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "achievements": {
      ".indexOn": ["points", "category", "isActive"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$achievementId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "learning_paths": {
      ".indexOn": ["teacherId", "subject", "createdAt", "isPublished"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$pathId": {
        ".read": "auth != null && (data.child('teacherId').val() == auth.uid || data.child('isPublished').val() == true)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['title', 'description', 'teacherId', 'teacherName', 'subjects', 'steps', 'isPublished'])"
      }
    },
    "student_learning_paths": {
      ".indexOn": ["studentId", "teacherId", "learningPathId", "assignedAt", "status"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$assignmentId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['studentId', 'studentName', 'learningPathId', 'learningPathTitle', 'teacherId', 'assignedAt', 'status'])"
      }
    },
    "student_approvals": {
      ".indexOn": ["studentId", "teacherId", "status", "gradeLevel", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$approvalId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['studentId', 'studentName', 'studentEmail', 'gradeLevel', 'status', 'createdAt'])"
      }
    },
    "classes": {
      ".indexOn": ["teacherId", "subject", "section", "classCode", "schoolYear", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$classId": {
        ".read": "auth != null && (data.child('teacherId').val() == auth.uid || data.child('enrolledStudentIds').hasChild(auth.uid))",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['teacherId', 'teacherName', 'subject', 'section', 'classCode', 'schoolYear', 'createdAt', 'updatedAt'])"
      }
    },
    "class_enrollments": {
      ".indexOn": ["classId", "studentId", "teacherId", "enrolledAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$enrollmentId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['classId', 'studentId', 'studentName', 'teacherId', 'enrolledAt'])"
      }
    },
    "lesson_progress": {
      ".indexOn": ["studentId", "lessonId", "subject", "teacherId", "lastActivity"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$progressId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && data.child('studentId').val() == auth.uid",
        ".validate": "newData.hasChildren(['studentId', 'lessonId', 'subject', 'teacherId', 'createdAt'])"
      }
    },
    "student_ratings": {
      ".indexOn": ["studentId", "sectionId", "subjectId", "teacherId", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$ratingId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['studentId', 'sectionId', 'subjectId', 'teacherId', 'rating', 'createdAt'])"
      }
    },
    "student_feedback": {
      ".indexOn": ["studentId", "teacherId", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$feedbackId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['studentId', 'studentName', 'teacherId', 'teacherName', 'feedback', 'createdAt'])"
      }
    },
    "student_recommendations": {
      ".indexOn": ["studentId", "teacherId", "createdAt", "priority"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$recommendationId": {
        ".read": "auth != null && (data.child('studentId').val() == auth.uid || data.child('teacherId').val() == auth.uid)",
        ".write": "auth != null && data.child('teacherId').val() == auth.uid",
        ".validate": "newData.hasChildren(['studentId', 'studentName', 'teacherId', 'teacherName', 'title', 'description', 'createdAt'])"
      }
    }
  }
}
